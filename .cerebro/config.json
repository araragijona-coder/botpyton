{
  "schema_version": 1,
  "bot_name": "BotPyton",
  "mode": "deterministic_known_fixes",
  "ai_enabled": false,
  "external_ai_apis_enabled": false,
  "default_max_attempts": 3,
  "unknown_error_policy": "stop_and_report",
  "automatic_merge": false,
  "automatic_source_repairs_enabled": true,
  "known_fix_rules": [
    {
      "id": "json.remove_single_trailing_comma",
      "requires_exact_signature": "JSONDecodeError",
      "requires_unique_invalid_file": true,
      "requires_parser_verification": true,
      "creates_backup": true
    },
    {
      "id": "python.add_missing_compound_header_colon",
      "requires_exact_signature": "SyntaxError: expected ':'",
      "requires_unique_invalid_file": true,
      "requires_parser_verification": true,
      "creates_backup": true
    }
  ],
  "protected_paths": [
    ".github/",
    ".cerebro/config.json",
    ".cerebro/policies/",
    ".cerebro/memory/",
    ".cerebro/reports/",
    ".cerebro/backups/"
  ],
  "allowed_actions": [
    "inspect_repository",
    "validate_task",
    "run_tests",
    "apply_known_fix",
    "prepare_report"
  ],
  "github_operations": {
    "enabled": true,
    "default_mode": "dry_run",
    "execution_requires_explicit_workflow_dispatch_opt_in": true,
    "branch_prefix": "botpyton/",
    "max_files_per_plan": 20,
    "max_file_bytes": 200000,
    "max_total_bytes": 500000,
    "allowed_suffixes": [
      ".py",
      ".md",
      ".json",
      ".toml",
      ".txt"
    ],
    "protected_paths": [
      ".github/",
      ".cerebro/config.json",
      ".cerebro/policies/",
      ".cerebro/memory/",
      ".cerebro/reports/",
      ".cerebro/backups/"
    ],
    "default_pull_request_type": "draft",
    "automatic_merge": false,
    "read_only_job_permissions": [
      "contents: read"
    ],
    "submission_job_permissions": [
      "contents: write",
      "pull-requests: write"
    ]
  }
}
